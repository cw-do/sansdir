# OS
.DS_Store
Thumbs.db

# sansdir runtime artifacts (per CLAUDE.md / PLANNING.md)
.cache/
*.log

# Real SANS data fixtures are large (300+ MB NeXus files); excluded from VCS.
# Tests use synthetic fixtures from tests/conftest.py instead.
# See tests/data/README.md for how to obtain the real files.
tests/data/*.nxs.h5

# Local-only kickoff brief
kikoffprompt.md

# LaTeX build intermediates (docs/). The built PDF is committed; these are not.
*.aux
*.bbl
*.bcf
*.blg
*.run.xml
*.toc
*.lof
*.lot
*.out
*.acr
*.acn
*.synctex.gz

# Screenshot SVGs are intermediates of `make figures`; LaTeX consumes the PDFs.
docs/figures/*.svg

# Working documents for the AI coding agent — kept locally, not published.
CLAUDE.md
PLANNING.md
PLANNING-*.md
TASKS.md

# Algorithm reference material: published papers (IUCr / AIP copyright) and
# the prototype script they were implemented from. The repo is public, so the
# PDFs stay local — sansdir/usans/desmear.py cites both by DOI instead.
docs/desmear_ref/
docs/desmear.py
docs/usans_gpr_inversion.pdf

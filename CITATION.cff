    given-names: "Changwoo"
    email: "doc1@ornl.gov"
    affiliation: "Oak Ridge National Laboratory"
license: MIT
repository-code: "https://github.com/cw-do/sansdir"
keywords:
  - small-angle neutron scattering
  - SANS
  - USANS
  - neutron scattering
  - data reduction
  - terminal user interface
references:

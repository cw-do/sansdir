    title: "Analytical desmearing of Bonse-Hart ultra-small-angle neutron scattering data via truncated Abel inversion"
    authors:
      - family-names: "Huang"
        given-names: "Guan-Rong"
      - family-names: "Chen"
        given-names: "Wei-Ren"
    journal: "Journal of Applied Crystallography"
    volume: 59
    start: 1083
    year: 2026
    notes: "Algorithm implemented in sansdir.usans.desmear"
